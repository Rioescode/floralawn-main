# SECURITY WARNING: Never commit .env files to version control
# Copy this file to .env.local and fill in your actual values

# -----------------------------------------------------------------------------
# NextAuth: https://shipfa.st/docs/tutorials/user-auth
# -----------------------------------------------------------------------------
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=your_nextauth_secret_key_min_32_chars

# -----------------------------------------------------------------------------
# Google OAuth: https://shipfa.st/docs/features/google-oauth
# -----------------------------------------------------------------------------
GOOGLE_ID=
GOOGLE_SECRET=

# -----------------------------------------------------------------------------
# Resend: https://shipfa.st/docs/features/emails
# -----------------------------------------------------------------------------
RESEND_API_KEY=your_resend_api_key

# -----------------------------------------------------------------------------
# Database URI: https://shipfa.st/docs/features/database
# -----------------------------------------------------------------------------
MONGODB_URI=your_mongodb_connection_string

# -----------------------------------------------------------------------------
# Stripe: https://shipfa.st/docs/features/payments
# -----------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# EmailJS Credentials
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_APP_NAME="Flora Lawn & Landscaping Inc"
SITE_URL=https://yourdomain.com

# Telegram Notifications (Optional) - Server-side only
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Google Maps API - Server-side only (for geocoding and route optimization)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Google Maps API - Client-side (for autocomplete suggestions)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Anthropic API (Claude AI)
ANTHROPIC_API_KEY=your_anthropic_api_key

# DeepSeek API (yard photo chat). Server-side only. Never use a NEXT_PUBLIC_ name.
DEEPSEEK_API_KEY=your_deepseek_api_key

# My Green Robot partner lead forwarding. Server-side only.
# Never use a NEXT_PUBLIC_ name. The secret must not reach the browser.
# Set both on the host. If either is missing, the contact form still saves
# the lead and consented leads are not forwarded.
# Production host is Netlify: Site configuration → Environment variables.
# Canonical endpoint (use this unless My Green Robot gives you another URL):
MGR_PARTNER_LEADS_URL=https://mygreenrobot.com/api/partner-leads
MGR_PARTNER_LEADS_SECRET=

# Flora phone line (+14012053853) inbox webhooks. Server-side only.
# ElevenLabs post-call HMAC secret from the workspace webhook. Required for /api/voice/post-call.
ELEVENLABS_FLORA_WEBHOOK_SECRET=
# Shared secret for the conversation-initiation caller lookup.
# ElevenLabs must send it as the X-Flora-Init-Secret header. Required for a real lookup.
ELEVENLABS_FLORA_INIT_SECRET=
# Already used for outbound SMS. Required to validate inbound SMS at /api/sms/inbound.
TWILIO_AUTH_TOKEN=
# Optional. Set this to the exact URL configured in Twilio when it is not
# ${SITE_URL}/api/sms/inbound (www vs apex, or a query string).
# TWILIO_SMS_WEBHOOK_URL=https://floralawn-and-landscaping.com/api/sms/inbound

# Security Notes:
# 1. Use strong, unique API keys
# 2. Rotate keys regularly
# 3. Use different keys for development/production
# 4. Monitor API usage for unusual activity
# 5. Set up proper CORS policies
# 6. Enable rate limiting in production